# --- OpenTrace Services platform (Railway self-hosted infra) ---
# Deploy via Railway templates; document connection strings here for consumer repos.

# App Redis (sessions for ml-eng, optional checkpoints for research lab)
# RAG_REDIS_URL=redis://default:password@redis.railway.internal:6379/0
# CHECKPOINT_REDIS_URL=redis://default:password@redis.railway.internal:6379/1

# Langfuse (optional tracing for ml-eng and future research lab POCs)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://your-langfuse-web.up.railway.app

# --- Research lab raw storage ---
RAW_STORE_BACKEND=local
RAW_STORE_ROOT=./storage

# GCS (when RAW_STORE_BACKEND=gcs)
# GCS_BUCKET=opentrace-raw-research
# GCS_PREFIX=raw/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Checkpoint (dedupe / resume across long mining runs)
CHECKPOINT_BACKEND=file
# CHECKPOINT_ROOT=./checkpoints
# CHECKPOINT_REDIS_URL=redis://localhost:6379/1

# Manifest output directory (relative to research/ when running CLI)
# MANIFEST_ROOT=./manifests
